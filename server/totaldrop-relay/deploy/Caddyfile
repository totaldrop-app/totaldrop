{
	# UDP 443 belongs to the relay's address discovery, so no HTTP/3.
	servers {
		protocols h1 h2
	}
	# Caddy's access log is off unless configured; keep it that way.
}

# install.sh replaces RELAY_HOST with the server's name.
RELAY_HOST {
	# Clients dial /v0/relay/<key A>-<key B>; Caddy paths match exactly
	# unless they end in *.
	@relay path /v0/relay /v0/relay/*
	handle @relay {
		reverse_proxy 127.0.0.1:4100
	}
	handle {
		respond "TotalDrop relay" 200
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
}

{
  "@@locale": "en",
  "cliPreparing": "Preparing…",
  "cliWaiting": "Waiting for the receiver…",
  "cliConnectingCode": "Connecting with {code}…",
  "@cliConnectingCode": {"description": "Said before the receiver connects. The code is the one read from what was typed, in English and ASCII, so the person can check it", "placeholders": {"code": {"type": "String", "example": "7-harbor-rocket"}}},
  "cliConnected": "Connected, end-to-end encrypted.",
  "cliVerification": "Verification words: {words}",
  "@cliVerification": {"description": "The words stay in English in every language; both sides compare them", "placeholders": {"words": {"type": "String", "example": "apple river stone moon"}}},
  "cliProgress": "{percent}%  {done} of {total}",
  "@cliProgress": {"placeholders": {"percent": {"type": "int", "format": "decimalPattern"}, "done": {"type": "String", "example": "1.5 MB"}, "total": {"type": "String", "example": "12 MB"}}},
  "cliSkipping": "{count, plural, one{Skipping {count} symbolic link or special file.} other{Skipping {count} symbolic links or special files.}}",
  "@cliSkipping": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}}},
  "cliSending": "{count, plural, one{Sending {count} item, {size}.} other{Sending {count} items, {size}.}}",
  "@cliSending": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}, "size": {"type": "String", "example": "12 MB"}}},
  "cliRunThis": "On the other device, run:",
  "@cliRunThis": {"description": "Followed by the command on its own line, which is never translated"},
  "cliSendDone": "{count, plural, one{Done: {count} file sent and verified.} other{Done: {count} files sent and verified.}}",
  "@cliSendDone": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}}},
  "cliSendSomeFailed": "{count, plural, one{Done, but {count} file did not arrive intact and was discarded.} other{Done, but {count} files did not arrive intact and were discarded.}}",
  "@cliSendSomeFailed": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}}},
  "cliOffered": "Offered: {files, plural, one{{files} file} other{{files} files}}, {dirs, plural, one{{dirs} folder} other{{dirs} folders}}, {size} in total:",
  "@cliOffered": {"placeholders": {"files": {"type": "int", "format": "decimalPattern"}, "dirs": {"type": "int", "format": "decimalPattern"}, "size": {"type": "String", "example": "12 MB"}}},
  "cliAndMore": "… and {count} more",
  "@cliAndMore": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}}},
  "cliPromptSave": "Save into {folder}? [y/N] ",
  "@cliPromptSave": {"description": "Keep the trailing space. [y/N] shows the answers from cliYes; N is the default", "placeholders": {"folder": {"type": "String", "example": "/home/ada/Downloads"}}},
  "cliYes": "y|yes",
  "@cliYes": {"description": "Answers that mean yes, separated by |. English y and yes always work too"},
  "cliDeclined": "Declined.",
  "cliSaved": "Saved {name}",
  "@cliSaved": {"placeholders": {"name": {"type": "String", "example": "photos/beach.jpg"}}},
  "cliReceiveSomeFailed": "{count, plural, one{{count} file did not arrive intact and was discarded.} other{{count} files did not arrive intact and were discarded.}}",
  "@cliReceiveSomeFailed": {"placeholders": {"count": {"type": "int", "format": "decimalPattern"}}},
  "cliRelayOnlyNeedsRelay": "--relay-only needs a relay",
  "@cliRelayOnlyNeedsRelay": {"description": "--relay-only is an option name and stays as it is"},
  "cliStopping": "Stopping… (press Ctrl-C again to quit at once)",
  "@cliStopping": {"description": "Ctrl-C is the key name and stays as it is"},
  "cliStopped": "Stopped.",
  "cliNoFolder": "{folder} does not exist or is not a folder.",
  "@cliNoFolder": {"placeholders": {"folder": {"type": "String", "example": "/home/ada/Downloads"}}},
  "cliFolderNotWritable": "Cannot write to {folder}.",
  "@cliFolderNotWritable": {"placeholders": {"folder": {"type": "String", "example": "/home/ada/Downloads"}}},
  "cliErrWrongCode": "The code did not match. It was mistyped, or someone tried to intercept the transfer. Nothing was sent. Start again with a new code.",
  "cliErrPeerLeft": "The other side left before the transfer finished.",
  "cliErrDeclined": "The receiver declined the files.",
  "cliErrNoRoom": "The files are too large for the receiver, or it has no room for them.",
  "cliErrCancelled": "The other side stopped the transfer.",
  "cliErrInvalidCode": "That code is not valid.",
  "cliErrCodeNotInUse": "That code is not in use: it was mistyped, has expired or was already used. Ask the sender for a new one.",
  "cliErrCodeExpired": "Nobody used the code before it expired. Send again to get a new code.",
  "@cliErrCodeExpired": {"description": "Shown to the sender: nobody came for the code before the server let it expire (15 minutes)"},
  "cliErrBadServer": "The server address is not valid. It must start with wss://.",
  "cliErrServer": "Could not reach the TotalDrop server. Check your internet connection.",
  "cliErrConnect": "Could not connect to the other device. Check that both devices are online and try again.",
  "cliErrInvalidOffer": "The offer broke a safety rule, so it was refused.",
  "cliErrStorage": "A file could not be read or saved.",
  "cliErrOther": "Something went wrong."
}
